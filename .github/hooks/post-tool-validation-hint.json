        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "python3 scripts/hooks/copilot_global_hook_bridge.py post-tool",
        "powershell": "python scripts/hooks/copilot_global_hook_bridge.py post-tool",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
