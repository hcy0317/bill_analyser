{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/pre_tool_repo_guard.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python scripts/hooks/copilot_global_hook_bridge.py pre-tool",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
