# Bill Analyser - Environment Variables Example
# ================================================
# Copy this file to .env and modify as needed
# ================================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Security (Optional)
# Set a password for sensitive operations like bulk delete
# BILL_ANALYSER_OPERATION_PASSWORD=your_secure_password
# Set a secret to enable encrypted local backup artifacts
# BILL_ANALYSER_BACKUP_ENCRYPTION_KEY=your-backup-encryption-secret

# Database Configuration
# DATABASE_PATH=data/bills.db
# BILL_ANALYSER_SQLITE_DB_PATH=data\bills.db
# BILL_ANALYSER_SQLITE_LEGACY_PATH=data\bills.db
# BILL_ANALYSER_DATABASE_BACKEND=sqlite
# BILL_ANALYSER_POSTGRES_URL=postgres://bill_analyser:bill_analyser_dev@127.0.0.1:5432/bill_analyser
# BILL_ANALYSER_MIGRATION_MODE=disabled
# BILL_ANALYSER_REQUIRE_POSTGRES_AFTER_CUTOVER=false

# Local PostgreSQL compose helper
# BILL_ANALYSER_POSTGRES_DB=bill_analyser
# BILL_ANALYSER_POSTGRES_USER=bill_analyser
# BILL_ANALYSER_POSTGRES_PASSWORD=bill_analyser_dev
# BILL_ANALYSER_POSTGRES_PORT=5432

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs

# JWT Configuration (for authentication)
# JWT_SECRET_KEY=your-secret-key-change-in-production
# JWT_ACCESS_TOKEN_EXPIRES=3600
